{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laralion",
  "compatibility_date": "2026-06-06",
  "observability": {
    "enabled": true
  },
  // Серверная логика Worker (OAuth-эндпоинты /api/auth и /api/callback).
  "main": "worker.js",
  // Статический сайт раздаётся из корня репозитория; binding ASSETS
  // позволяет worker.js отдавать файлы для всех не-/api запросов.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}